# Salesforce Developer Edition org URL
SF_BASE_URL=https://your-domain.lightning.force.com

# ---------------------------------------------------------------------------
# Sample data for the authenticated tests (tests/*.auth.spec.ts).
# These are ORG-SPECIFIC: use records from your own org. Each line below is commented
# out so that copying this file leaves them unset. Tests that need a variable are
# skipped (with the missing names in the skip message) until you set it in your own
# .env. Never commit .env.
# ---------------------------------------------------------------------------

# Record details test (tests/salesforce-records.auth.spec.ts), read-only.
# An existing Account, one of its Contacts, and one of its Opportunities.
# Ids are 15 or 18 characters. Values must match what the record pages display.
# SF_ACCOUNT_ID=<18-character Account id>
# SF_ACCOUNT_NAME=<Account name>
# SF_ACCOUNT_RATING=<Account Rating, e.g. Warm>
# SF_ACCOUNT_INDUSTRY=<Account Industry>
# SF_ACCOUNT_TYPE=<Account Type>
# SF_CONTACT_ID=<18-character Contact id>
# SF_CONTACT_NAME=<Contact first and last name, without salutation>
# SF_CONTACT_EMAIL=<Contact email>
# SF_CONTACT_TITLE=<Contact Title>
# SF_OPPORTUNITY_ID=<18-character Opportunity id>
# SF_OPPORTUNITY_NAME=<Opportunity name>
# SF_OPPORTUNITY_STAGE=<Opportunity Stage>
# SF_OPPORTUNITY_AMOUNT=<Amount exactly as displayed, with currency and locale formatting>

# Lead conversion dialog and preparation tests, read-only (they only open the dialog and
# cancel). An existing, UNCONVERTED Lead. The company and name must match that Lead,
# because Salesforce copies them into the Convert Lead dialog.
# The guarded conversion test also needs SF_CONVERT_LEAD_ID. It is disabled by default
# and creates real records when enabled, so it is documented in the README, not here.
# SF_CONVERT_LEAD_ID=<18-character Lead id>
# SF_CONVERT_LEAD_COMPANY=<Lead company>
# SF_CONVERT_LEAD_FIRST_NAME=<Lead first name>
# SF_CONVERT_LEAD_LAST_NAME=<Lead last name>
